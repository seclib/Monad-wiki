# MONAD runtime configuration
#
# Copy this file before running Docker Compose:
#   cp .env.example .env
#
# Generate strong local secrets:
#   openssl rand -base64 32
#
# Never commit the generated .env file.

# Compose identity
COMPOSE_PROJECT_NAME=monad

# Runtime mode
NODE_ENV=production
LOG_LEVEL=info

# Required secrets
# Replace every value below before real use.
APP_KEY=REPLACE_WITH_OPENSSL_RAND_BASE64_32
DB_PASSWORD=REPLACE_WITH_STRONG_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=REPLACE_WITH_STRONG_MYSQL_ROOT_PASSWORD

# Public/local access
# Default binds Caddy to localhost only.
# Use MONAD_HTTP_BIND=0.0.0.0 only when you intentionally want LAN access.
URL=http://monad.local
MONAD_HTTP_BIND=127.0.0.1
MONAD_HTTP_PORT=80
CADDY_INTERNAL_PORT=8080
ADMIN_INTERNAL_PORT=8050

# Reproducible image selection
# MONAD images are built from this repository by default and tagged "local".
# For a published release, set these tags to the release version, for example v1.0.0.
MONAD_IMAGE_TAG=local
MONAD_DISK_COLLECTOR_IMAGE_TAG=local
CADDY_IMAGE=caddy:2.8.4-alpine
MYSQL_IMAGE=mysql:8.0.40
REDIS_IMAGE=redis:7.4.1-alpine

# Project-local host paths
# Keep these relative so the repository is portable when copied to another machine.
MONAD_HOST_STORAGE_PATH=./storage
MONAD_HOST_LOGS_PATH=./logs
MONAD_HOST_CACHE_PATH=./cache
MONAD_HOST_CONFIG_PATH=./config
MONAD_HOST_MODELS_PATH=./models
MONAD_HOST_DATA_PATH=./data
MONAD_HOST_MYSQL_DATA_PATH=./data/mysql
MONAD_HOST_REDIS_DATA_PATH=./data/redis
MONAD_HOST_CADDY_DATA_PATH=./data/caddy/data
MONAD_HOST_CADDY_CONFIG_PATH=./config/caddy
MONAD_HOST_UPDATE_SHARED_PATH=./cache/update-shared

# Application-internal project-relative paths
MONAD_PROJECT_ROOT=.
MONAD_STORAGE_PATH=storage
MONAD_LOGS_PATH=logs
MONAD_CACHE_PATH=cache
MONAD_CONFIG_PATH=runtime/config
MONAD_MODELS_PATH=models
MONAD_DATA_PATH=data
PMTILES_BINARY_PATH=bin/pmtiles

# Storage encryption
# MONAD_ENCRYPTION_KEY may be a 32-byte base64 or hex value. When unset, MONAD
# generates config/key.bin and wraps it with MONAD_ENCRYPTION_PASSWORD or APP_KEY.
MONAD_ENCRYPTION_KEY=
MONAD_ENCRYPTION_PASSWORD=

# Optional restricted Docker API access.
# Leave blank for the default self-contained mode with Docker control disabled.
MONAD_DOCKER_HOST=
MONAD_DOCKER_SOCKET_PATH=

# Project identity
APP_AUTHOR=seclib
PROJECT_NAME=MONAD
PROJECT_REGION=Reunion
PROJECT_TAGLINE=Optimisé pour La Réunion
PROJECT_DESCRIPTION=Système local de gestion et de connaissance

# Locale defaults
DEFAULT_LANGUAGE=fr
APP_LOCALE=fr_FR
DATE_FORMAT=DD/MM/YYYY
TZ=Indian/Reunion
LANG=fr_FR.UTF-8
LC_ALL=fr_FR.UTF-8

# Database
DB_DATABASE=monad
DB_NAME=monad
DB_USER=monad_user
DB_SSL=false

# Optional external/local services
MONAD_OFFLINE_MODE=true
MONAD_API_URL=https://api.monad.local
MONAD_BENCHMARK_API_URL=https://benchmark.monad.local/api/v1
OLLAMA_BASE_URL=http://host.docker.internal:11434
VAULT_PATH=storage/vault

# Admin behavior
DISABLE_COMPRESSION=false
SYSTEM_PROMPT=Tu es l'assistant IA de MONAD pour La Réunion. Tu réponds toujours en français clair, naturel et structuré, avec le contexte local de La Réunion lorsque c'est pertinent, sauf demande explicite contraire.
