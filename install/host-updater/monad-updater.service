[Unit]
Description=MONAD secure host-side updater
Documentation=file:/opt/monad/install/host-updater/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
Environment=MONAD_COMPOSE_PROJECT=monad
Environment=MONAD_COMPOSE_FILE=/opt/monad/compose.yml
Environment=MONAD_UPDATE_SHARED_DIR=/opt/monad/update-shared
Environment=MONAD_UPDATER_HOST=127.0.0.1
Environment=MONAD_UPDATER_PORT=8765
Environment=MONAD_UPDATER_TOKEN_FILE=/etc/monad/updater.token
ExecStart=/usr/bin/python3 /opt/monad/install/host-updater/monad_updater_daemon.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/opt/monad /etc/monad

[Install]
WantedBy=multi-user.target
