[Unit]
Description=MONAD secure host-side updater
Documentation=file:install/host-updater/README.md
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=root
Group=root
Environment=MONAD_COMPOSE_PROJECT=monad
Environment=MONAD_PROJECT_ROOT=.
Environment=MONAD_COMPOSE_FILE=docker-compose.yaml
Environment=MONAD_UPDATE_SHARED_DIR=cache/update-shared
Environment=MONAD_UPDATER_HOST=127.0.0.1
Environment=MONAD_UPDATER_PORT=8765
Environment=MONAD_UPDATER_TOKEN_FILE=config/updater.token
ExecStart=python3 install/host-updater/monad_updater_daemon.py
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=.

[Install]
WantedBy=multi-user.target
