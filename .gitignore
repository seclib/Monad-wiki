# Logs
logs/*
!logs/.gitkeep
*.log

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Dependencies and package-manager cache
node_modules/
admin/node_modules/
.npm/
__pycache__/
*.py[cod]

# Environment files
.env
.env.*
!.env.example
!admin/.env.example

# Build and generated output
dist/
build/
tmp/
admin/build/
admin/public/assets/
build/Release/

# Runtime-generated MONAD data
/storage/*
cache/*
!cache/.gitkeep
/config/*
!/config/.gitkeep
!/config/permissions.json
!/config/settings.json
!/config/caddy/
!/config/caddy/Caddyfile
models/*
!models/.gitkeep
data/*
!data/.gitkeep
admin/storage/
server/public/
server/temp/
vault/*
!vault/.gitkeep

# Large local content and databases
*.db
*.sqlite
*.sqlite3
*.zim
*.pmtiles

# OS and editor metadata
.DS_Store
.vscode/
.idea/

# Local font drops
*.ttf
